# Mercado Pago Point — El Huerto
# En producción estas variables viven en Vercel → Settings → Environment
# Variables (no en este archivo). Copia a .env solo para correr
# scripts/point-terminal.mjs en tu compu. Nunca subas .env a git.

# App "El Huerto POS" (2249509833805529) → Credenciales → pestaña Producción
MP_ACCESS_TOKEN=APP_USR-...

# id de la Point Smart 2 (sale de: node --env-file=.env scripts/point-terminal.mjs)
MP_POINT_TERMINAL_ID=

# Quién puede mandar cobros a la terminal (cuentas propias de Firebase)
MP_POINT_STAFF_EMAILS=admin@elhuerto.app,emp2002@elhuerto.app,emp2005@elhuerto.app,emp2006@elhuerto.app

# Solo para pruebas sin terminal (terminal virtual oficial). Nunca en producción.
MP_POINT_TEST_MODE=false

# Para el siguiente paso (webhook de órdenes): Dashboard → Webhooks → clave secreta
MP_WEBHOOK_SECRET=
